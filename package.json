{
  "name": "zenox-account-router",
  "version": "0.3.1",
  "description": "Smart, quota-aware account routing and failover for OpenCode V2 — uses the subscription allowance that expires first, never breaks a warm prompt cache, paid API key last.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "zenox",
    "anthropic",
    "claude",
    "openai",
    "chatgpt",
    "codex",
    "failover",
    "rate-limit",
    "quota",
    "multi-account"
  ],
  "homepage": "https://github.com/CyberBoyAyush/zenox-account-router#readme",
  "bugs": {
    "url": "https://github.com/CyberBoyAyush/zenox-account-router/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyberBoyAyush/zenox-account-router.git"
  },
  "license": "MIT",
  "author": "Ayush Sharma (https://github.com/CyberBoyAyush)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.17.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "zenox-account-router": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs/implementation.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-tui.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "prepack": "tsc -p tsconfig.build.json && node scripts/build-tui.mjs",
    "prepublishOnly": "pnpm run check"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/js": "^9.39.0",
    "@ex-machina/opencode-anthropic-auth": "2.0.0-next.6",
    "@opencode/client": "2.2.5",
    "@opencode/plugin": "2.2.5",
    "@opencode/sdk": "2.2.5",
    "@opencode/theme": "2.2.5",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^3.2.4",
    "babel-preset-solid": "^1.9.16",
    "eslint": "^9.39.0",
    "fast-check": "^4.10.2",
    "solid-js": "^1.9.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.5 <3",
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
